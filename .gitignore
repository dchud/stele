# Byte-compiled files
__pycache__/
*.py[codz]

# Packaging
build/
dist/
*.egg-info/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environments and credentials
#   uv.lock is committed on purpose: one resolution for CI and local runs
#   alike. .python-version is not, because `requires-python` already selects
#   the interpreter - uv resolves to the lowest version satisfying it.
.python-version
.venv/
venv/
.env
.envrc
.pypirc

# macOS
.DS_Store

# Local tool state
.abacus/

# Pipeline output: regenerable, and describes one catalog rather than the tool
model.yaml
overlay.yaml
replica.sql
models/

# Built documentation
site/

# Agent worktrees, which would otherwise be linted as part of the tree
.claude/worktrees/

# Scratch
tmp/
